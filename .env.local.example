# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.

# URL pública de la aplicación
NEXT_PUBLIC_URL=http://localhost:3000

# NextAuth — generar con: openssl rand -hex 32  (debe tener 64 caracteres)
AUTH_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<id-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email transaccional)
RESEND_API_KEY=
